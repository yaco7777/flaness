# ---------------------------------------------------------------------------
# Copiá este archivo como .env y completá los valores. NUNCA subas el .env.
# En producción (Render) cargá estas mismas variables en el panel Environment.
# ---------------------------------------------------------------------------
PROJECT_NAME=Culto al Flan — API

# Desarrollo local:
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/ecommerce_db
# Neon (producción) — copiá la "Connection string" del panel de Neon:
# DATABASE_URL=postgresql://<usuario>:<contraseña>@<endpoint>.neon.tech/<base>?sslmode=require&channel_binding=require

# Orígenes permitidos, separados por coma (agregá la URL de Vercel en producción)
CORS_ORIGINS=http://localhost:5173

# Generá una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Usadas solo por "python -m app.seed" para crear el admin inicial
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
